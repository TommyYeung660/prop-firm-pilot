# ── MatchTrader API ──────────────────────────────────────────────
MATCHTRADER_API_URL=https://mtr.e8markets.com
MATCHTRADER_USERNAME=your_email@example.com
MATCHTRADER_PASSWORD=your_password
MATCHTRADER_BROKER_ID=2
MATCHTRADER_ACCOUNT_ID=your_account_id

# ── TradeLocker API ──────────────────────────────────────────────
TRADELOCKER_API_URL=https://api.tradelocker.com/backend-api
TRADELOCKER_EMAIL=your_email@example.com
TRADELOCKER_PASSWORD=your_password
TRADELOCKER_SERVER=demo
TRADELOCKER_ACCOUNT_ID=your_account_id

# ── FX Data Providers ───────────────────────────────────────────
ITICK_API_KEY=your_itick_api_key
TRADERMADE_API_KEY=your_tradermade_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# ── EODHD (eodhistoricaldata.com) ──────────────────────────────
# Primary data provider (v1.3.0+)
# Free tier: 20 API calls/day | Paid (All World Extended): 100K calls/day
EODHD_API_KEY=your_eodhd_api_key_here
# EODHD_SWITCHOVER_DATE=2026-03-21    # Date to switch from AV to EODHD (default: 2026-03-21)
# EODHD_FORCE_PRIMARY=1               # Force EODHD regardless of date (for testing)

# ── Dropbox (inter-project sync) ────────────────────────────────
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token

# ── LLM (for TradingAgents) ─────────────────────────────────────
# LLM 設定請在 ../../TradingAgents/.env 設置
# (RIGHTCODE_*, VOLCENGINE_*, AIHUBMIX_*, LLM_*)

# ── Telegram Alerts ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
